# Shared server credentials for the interim Next.js + NestJS deployment.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# NestJS API
API_PORT=4000

# Disabled-by-default Next.js to NestJS retrieval parity comparison.
RAG_SHADOW_NEST=false
NEST_API_URL=http://localhost:4000
RAG_BACKEND=legacy
RAG_NEST_TIMEOUT_MS=3500
RAG_NEST_INTERNAL_USER_IDS=

# Low-confidence knowledge-base abstention. Start with observe before enforce.
RAG_ABSTENTION_MODE=disabled
RAG_ABSTAIN_MIN_RERANK_SCORE=0.60
RAG_ABSTAIN_MIN_SCORE_GAP=0.05

# Comma-separated allowlist for internal Next.js admin pages.
ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────
# Migration 005: Next → Nest service migration
# ─────────────────────────────────────────────────────────────

# Nest API base URL, exposed to the browser for direct calls (Phase 4).
# Keep in sync with NEST_API_URL above; the NEXT_PUBLIC_ copy is what
# client components and route proxies read.
NEXT_PUBLIC_NEST_API_URL=http://localhost:4000

# CORS allowlist for the Nest API (comma-separated, no wildcard).
# Must include every origin the browser calls Nest from.
WEB_ORIGINS=http://localhost:3000,http://localhost:8000

# Shared secret for the ingestion worker → Nest /api/ingestion/process call.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INGESTION_WORKER_SECRET=

# Worker poll interval when no job is available (ms).
INGESTION_POLL_INTERVAL_MS=2000

# ── Per-service backend flags ────────────────────────────────
# All default to "web". Flip to "nest" one service at a time after
# its parity check passes. Server-side flags are read by the Nest
# config package; the NEXT_PUBLIC_ copies are read by the web
# route proxies and client components.

INGESTION_BACKEND=web
USER_BACKEND=web
CHAT_HISTORY_BACKEND=web
CHAT_BACKEND=web
FEEDBACK_BACKEND=web
DOCUMENTS_BACKEND=web

NEXT_PUBLIC_INGESTION_BACKEND=web
NEXT_PUBLIC_USER_BACKEND=web
NEXT_PUBLIC_CHAT_HISTORY_BACKEND=web
NEXT_PUBLIC_CHAT_BACKEND=web
NEXT_PUBLIC_FEEDBACK_BACKEND=web
NEXT_PUBLIC_DOCUMENTS_BACKEND=web

# ── Gradual rollout (Phase 4) ────────────────────────────────
# When enabled, per-user consistent hashing overrides the flags above.
# A given user always lands on the same backend, so sessions stay sticky.
# Allowlist/blocklist take precedence over the percentage.

NEXT_PUBLIC_NEST_ROLLOUT_ENABLED=false
NEXT_PUBLIC_NEST_ROLLOUT_PERCENTAGE=0
NEXT_PUBLIC_NEST_ROLLOUT_ALLOWLIST=
NEXT_PUBLIC_NEST_ROLLOUT_BLOCKLIST=

# ── Parity harness (Phase 0) ─────────────────────────────────
# Base URL of the running web app, used by scripts/parity/* to
# compare web responses against Nest.
WEB_BASE_URL=http://localhost:8000
