# Shared server credentials for the interim Next.js + NestJS deployment.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# NestJS API
API_PORT=4000

# Disabled-by-default Next.js to NestJS retrieval parity comparison.
RAG_SHADOW_NEST=false
NEST_API_URL=http://localhost:4000

# Low-confidence knowledge-base abstention. Start with observe before enforce.
RAG_ABSTENTION_MODE=disabled
RAG_ABSTAIN_MIN_RERANK_SCORE=0.60
RAG_ABSTAIN_MIN_SCORE_GAP=0.05

# Comma-separated allowlist for internal Next.js admin pages.
ADMIN_EMAILS=
